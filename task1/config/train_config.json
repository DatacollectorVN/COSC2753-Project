{
    "DATA_DIR_TRAIN": "../data/FashionDataset/train",
    "LABEL_COL": "articleType",

    "SAVE_MODEL_DIR": "./results",
    "SAVE_BEST": "val_acc",

    "SEED": 42,
    "IN_CHANNELS": 3,

    "MODEL_NAME": "resnet_cnn",
    "MODEL_PARAMS": {
        "depth": 50,
        "dropout_rate": 0.2
    },

    "TRANSFORM_PARAMS": {
        "width": 96,
        "height": 128,
        "pad_value": 0
    },

    "MIN_CLASS_COUNT": 50,
    "USE_CLASS_WEIGHTS": true,

    "BATCH_SIZE": 32,
    "VAL_RATIO": 0.2,
    "NUM_WORKERS": 4,

    "LEARNING_RATE": 1e-3,
    "WEIGHT_DECAY": 1e-4,
    "LR_SCHEDULE_FACTOR": 0.1,
    "LR_PATIENCE": 5,
    "EARLY_STOPPING_PATIENCE": 10,
    "MAX_EPOCHS": 100
}
