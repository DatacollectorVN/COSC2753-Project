{
  "task": {
    "name": "Fashion Season Classification",
    "target_column": "season",
    "classes": [
      "Spring",
      "Summer",
      "Fall",
      "Winter"
    ]
  },
  "paths": {
    "train_csv": "../FashionDataset/train/styles_train.csv",
    "train_images": "../FashionDataset/train/images_train",
    "test_csv": "../FashionDataset/test/styles_prediction.csv",
    "test_images": "../FashionDataset/test/images_test",
    "artifacts": "artifacts",
    "results": "results"
  },
  "data": {
    "image_width": 48,
    "image_height": 64,
    "holdout_ratio": 0.2,
    "random_seed": 42
  },
  "model_selection": {
    "procedure": "GridSearchCV",
    "estimator": "LinearSVC",
    "cross_validation_folds": 5,
    "primary_metric": "f1_macro",
    "secondary_metrics": [
      "accuracy",
      "f1_weighted"
    ]
  }
}
